# Vorlage für die Umgebungsvariablen (in Vercel unter Settings → Environment Variables eintragen)

# Postgres-Verbindung, wird von Neon über den Vercel Marketplace automatisch gesetzt
DATABASE_URL=postgres://benutzer:passwort@host/datenbank?sslmode=require
# Geheimer Schlüssel für die Anmelde-Cookies, mindestens 32 zufällige Zeichen
SESSION_SECRET=
# Einmaliger Schlüssel für die Einrichtung des ersten Administrators (mind. 8 Zeichen)
SETUP_KEY=

# --- E-Mail (Erinnerungen, Tickets) – eine der beiden Varianten ---
# Absender, z. B. Terminplaner <terminplaner@zimmerei-heinlein.de>
MAIL_FROM=
# Variante A: Resend (https://resend.com), Domain dort verifizieren
RESEND_API_KEY=
# Variante B: eigener SMTP-Server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Schützt den täglichen Erinnerungs-Job (mind. 16 zufällige Zeichen, Vercel sendet ihn automatisch mit)
CRON_SECRET=
# Optional: Adresse des Terminplaners für Links in E-Mails (sonst die Vercel-Produktionsadresse)
APP_URL=
