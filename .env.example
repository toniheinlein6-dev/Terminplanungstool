# Vorlage für die Umgebungsvariablen (in Vercel unter Settings → Environment Variables eintragen)
# Postgres-Verbindung, wird von Neon über den Vercel Marketplace automatisch gesetzt
DATABASE_URL=postgres://benutzer:passwort@host/datenbank?sslmode=require
# Geheimer Schlüssel für die Anmelde-Cookies, mindestens 32 zufällige Zeichen
SESSION_SECRET=
# Einmaliger Schlüssel für die Einrichtung des ersten Administrators (mind. 8 Zeichen)
SETUP_KEY=
